---
import { contrast, flavors, floorFor, type ColorKey } from '../data/palette';

interface Props {
  colorKey: ColorKey;
  /** Position in the page, for the wave the swatches make when the flavour changes. */
  index?: number;
}
const { colorKey, index = 0 } = Astro.props;

const perFlavor = flavors.map((f) => ({ flavor: f.id, color: f.colors[colorKey]! }));
const sample = perFlavor[0]!.color;
const cssVar = `--sp-${colorKey.replace(/_/g, '-')}`;

/* The name is set on the swatch itself, in whichever of the flavour's darkest
   surface or its brightest text reads better on it — decided per flavour at
   build time, and rendered once per flavour behind data-f, so the card needs
   no rule from the page it sits on. */
const inkFor = (flavor: string, hex: string) => {
  const f = flavors.find((x) => x.id === flavor)!;
  const dark = contrast(hex, f.colors.vao!.hex);
  const light = contrast(hex, f.colors.fg_vivo!.hex);
  return dark >= light ? 'var(--sp-vao)' : 'var(--sp-fg-vivo)';
};

/* Surfaces measured against surfaces say nothing, so the contrast bars are
   for the colours that are read: text, accents and their bright pairs. */
const SURFACES = ['vao', 'laje', 'concreto'] as const;
const showBars = sample.group !== 'surfaces';
/* A ratio of 16:1 fills the bar — fg_vivo on vao sits just above it. */
const SCALE = 16;
const pct = (n: number) => `${Math.min(100, (n / SCALE) * 100).toFixed(1)}%`;
---

<button
  class="color"
  type="button"
  data-copy-var={cssVar}
  aria-label={`Copy ${colorKey} hex value`}
  style={`--i: ${index}`}
>
  <span class="color__swatch" style={`background: var(${cssVar})`}>
    {
      perFlavor.map(({ flavor, color }) => (
        <span class="color__name mono" data-f={flavor} style={`color: ${inkFor(flavor, color.hex)}`}>
          {colorKey}
        </span>
      ))
    }
    <span class="color__copied mono" aria-hidden="true">copied</span>
  </span>

  <span class="color__body">
    <span class="color__meaning">{sample.meaning.en}</span>

    {/* All three flavours' values, side by side; the one on screen is lit. */}
    <span class="color__hexes mono">
      {
        perFlavor.map(({ flavor, color }) => (
          <span class="color__hex" data-lit={flavor}>
            <i style={`background: ${color.hex}`} />
            {color.hex}
          </span>
        ))
      }
    </span>

    {
      perFlavor.map(({ flavor, color }) => (
        <span class="color__detail" data-f={flavor}>
          <span class="color__meta mono" title="OKLCH lightness / chroma">
            L {color.oklch.l.toFixed(2)} · C {color.oklch.c.toFixed(3)}
          </span>

          {showBars && (
            <span class="color__bars">
              {SURFACES.map((s) => {
                const ratio = color.contrast[s];
                const floor = floorFor(colorKey, s);
                const ok = floor === undefined || ratio >= floor;
                return (
                  <span
                    class:list={['bar', !ok && 'bar--under']}
                    title={`${ratio.toFixed(2)}:1 on ${s}${floor ? ` — floor ${floor}:1` : ''}`}
                  >
                    <span class="bar__label mono">{s}</span>
                    <span class="bar__track">
                      <span class="bar__fill" style={`width: ${pct(ratio)}; background: var(${cssVar})`} />
                      {floor && <span class="bar__floor" style={`left: ${pct(floor)}`} />}
                    </span>
                    <span class="bar__ratio mono">{ratio.toFixed(1)}</span>
                  </span>
                );
              })}
            </span>
          )}
        </span>
      ))
    }
  </span>
</button>

<style>
  .color {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    padding: 0;
    overflow: hidden;
    background: var(--sp-laje);
    border: var(--border);
    border-radius: var(--radius);
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s var(--sp-ease), box-shadow 0.25s ease,
      background-color var(--sp-retint) ease;
  }

  .color:hover {
    border-color: var(--sp-fg-muted);
    transform: translateY(-2px);
  }

  .color:active {
    transform: translateY(0);
  }

  /* ------------------------------------------------------------ swatch */

  .color__swatch {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    height: 5.5rem;
    padding: 0.6rem 0.8rem;
    box-shadow: inset 0 -1px 0 color-mix(in oklab, var(--sp-vao) 35%, transparent);
    /* The colour follows the switcher in a wave down the page, one card after
       the next; the hover stays immediate. */
    transition: background-color var(--sp-retint) ease calc(var(--i, 0) * 22ms),
      height 0.3s var(--sp-ease);
  }

  .color:hover .color__swatch {
    height: 6.1rem;
  }

  /* Twenty-three cards on a phone: the swatch gives back the height. */
  @media (max-width: 34rem) {
    .color__swatch,
    .color:hover .color__swatch {
      height: 3.6rem;
    }
  }

  .color__name {
    font-weight: 650;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .color__copied {
    font-size: 0.7rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.25s var(--sp-ease);
  }

  .color.is-copied .color__copied {
    opacity: 1;
    transform: none;
  }

  .color.is-copied {
    border-color: color-mix(in oklab, var(--sp-ibira) 60%, var(--sp-fiacao));
  }

  .color.is-copied .color__swatch {
    animation: swatch-pop 0.45s var(--sp-ease);
  }

  @keyframes swatch-pop {
    40% {
      filter: brightness(1.25);
    }
    100% {
      filter: none;
    }
  }

  /* -------------------------------------------------------------- body */

  .color__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.75rem 0.85rem 0.85rem;
    min-width: 0;
  }

  .color__meaning {
    font-size: var(--step--1);
    color: var(--sp-fg-dim);
    line-height: 1.45;
  }

  .color__hexes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    font-size: 0.72rem;
  }

  .color__hex {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sp-fg-muted);
    transition: color var(--sp-retint) ease;
  }

  .color__hex i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--r-xs);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--sp-fg) 14%, transparent);
  }

  .color__detail {
    display: grid;
    gap: 0.45rem;
  }

  .color__meta {
    font-size: 0.7rem;
    color: var(--sp-fg-muted);
  }

  /* ------------------------------------------------------ contrast bars */

  .color__bars {
    display: grid;
    gap: 0.2rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 4.2rem 1fr 2.2rem;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    color: var(--sp-fg-muted);
  }

  .bar__track {
    position: relative;
    height: 5px;
    border-radius: var(--r-xs);
    background: var(--sp-concreto);
  }

  .bar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: var(--r-xs);
    transition: width 0.5s var(--sp-ease), background-color var(--sp-retint) ease;
  }

  /* The policy floor for this pair, as a tick across the track. */
  .bar__floor {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 1.5px;
    margin-left: -0.75px;
    background: var(--sp-fg);
    opacity: 0.55;
  }

  .bar__ratio {
    text-align: right;
    color: var(--sp-fg-dim);
  }

  .bar--under .bar__fill {
    background: var(--sp-brasa) !important;
  }

  .bar--under .bar__ratio {
    color: var(--sp-brasa);
  }
</style>
