---
import { flavors, defaultFlavor } from '../data/palette';
import { sceneAccent } from '../data/content';

/* Each dot is its flavour's sky: the dark surface on one side, the accent that
   names the scene on the other. Sodium for the city at night, the drizzle's
   blue-grey for garoa, the forest green for the peak. Falls back to sodio for
   any flavour the contract adds later. */
const SIGNATURE = sceneAccent as Record<string, string | undefined>;

const dot = (f: (typeof flavors)[number]) => {
  const accent = f.colors[SIGNATURE[f.id] ?? 'sodio']?.hex ?? f.colors.sodio?.hex;
  const dark = f.colors.laje?.hex;
  return `--dot: ${accent}; background: linear-gradient(135deg, ${dark} 0 48%, ${accent} 52% 100%)`;
};
---

<div class="flavors" role="radiogroup" aria-label="Colour flavour">
  <span class="flavors__thumb" aria-hidden="true"></span>
  {
    flavors.map((f) => (
      <button
        type="button"
        role="radio"
        data-flavor-btn={f.id}
        aria-checked={f.id === defaultFlavor}
        aria-label={f.label}
        title={f.description}
      >
        <span class="swatch" style={dot(f)} aria-hidden="true" />
        <span class="flavor-name">{f.label}</span>
        {/* Narrow screens swap the full name for the short id. */}
        <span class="flavor-id">{f.id}</span>
      </button>
    ))
  }
</div>

<script>
  const KEY = 'sp-night-flavor';
  const root = document.documentElement;
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  const groups = Array.from(document.querySelectorAll<HTMLElement>('.flavors'));
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-flavor-btn]'),
  );
  const ids = buttons.map((b) => b.dataset.flavorBtn!);

  const favicon = document.getElementById('favicon') as HTMLLinkElement | null;

  /* The sliding pill: measured from the checked button of each group, so the
     header switcher and the one on the home page each keep their own. */
  function placeThumbs() {
    for (const g of groups) {
      const on = g.querySelector<HTMLElement>('[aria-checked="true"]');
      const thumb = g.querySelector<HTMLElement>('.flavors__thumb');
      if (!on || !thumb) continue;
      thumb.style.setProperty('--x', `${on.offsetLeft}px`);
      thumb.style.setProperty('--w', `${on.offsetWidth}px`);
      g.classList.add('is-ready');
    }
  }

  function apply(id: string, persist = true) {
    if (!ids.includes(id)) return;
    root.dataset.flavor = id;
    if (favicon) favicon.href = `/favicon-${id}.svg`;
    if (persist) {
      try {
        localStorage.setItem(KEY, id);
      } catch {}
    }
    for (const b of buttons) {
      const on = b.dataset.flavorBtn === id;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    }
    placeThumbs();
    document.dispatchEvent(new CustomEvent('sp:flavor', { detail: id }));
  }

  /* Where supported, the new flavour opens out of the button that was pressed.
     Colour transitions are suppressed for the duration (html.is-swapping), so
     the circle reveals the finished page rather than one still fading. */
  function swap(id: string, from: HTMLElement, at?: { x: number; y: number }) {
    if (id === root.dataset.flavor) return;
    const vt = (document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } })
      .startViewTransition;
    if (!vt || calm.matches || root.classList.contains('is-swapping')) {
      apply(id);
      return;
    }
    const box = from.getBoundingClientRect();
    const x = at?.x ?? box.left + box.width / 2;
    const y = at?.y ?? box.top + box.height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty('--sp-wipe-x', `${x}px`);
    root.style.setProperty('--sp-wipe-y', `${y}px`);
    root.style.setProperty('--sp-wipe-r', `${Math.ceil(r)}px`);
    root.classList.add('is-swapping');
    try {
      const t = vt.call(document, () => apply(id));
      t.finished.finally(() => root.classList.remove('is-swapping'));
    } catch {
      root.classList.remove('is-swapping');
      apply(id);
    }
  }

  // Sync the buttons with whatever the head script already set on <html>.
  apply(root.dataset.flavor || ids[0]!, false);

  buttons.forEach((btn, i) => {
    btn.addEventListener('click', (e) => {
      const id = btn.dataset.flavorBtn!;
      // A keyboard "click" reports 0,0 — fall back to the button's centre.
      const at = e.clientX || e.clientY ? { x: e.clientX, y: e.clientY } : undefined;
      swap(id, btn, at);
    });
    btn.addEventListener('keydown', (e) => {
      const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      e.preventDefault();
      const next = buttons[(i + delta + buttons.length) % buttons.length]!;
      swap(next.dataset.flavorBtn!, next);
      next.focus();
    });
  });

  // The pill follows the buttons when they reflow (fonts, viewport).
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(() => placeThumbs());
    groups.forEach((g) => ro.observe(g));
  } else {
    addEventListener('resize', placeThumbs, { passive: true });
  }
  if ('fonts' in document) document.fonts.ready.then(placeThumbs);
</script>
