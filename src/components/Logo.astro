---
import { markBody } from '../lib/mark.mjs';

interface Props {
  size?: number;
  /** IDs must be unique per instance on a page. */
  id?: string;
  class?: string;
}
const { size = 26, id = 'mark', class: className } = Astro.props;
const colors = Object.fromEntries(
  ['vao', 'laje', 'temporal', 'sodio', 'concreto', 'fg_dim', 'brasa'].map(
    (key) => [key, `var(--sp-${key.replaceAll('_', '-')})`],
  ),
);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="SP Night — the Pico do Jaraguá at dusk"
  set:html={markBody(colors, id, size <= 32)}
/>

<style>
  svg {
    display: block;
    flex: 0 0 auto;
  }
</style>
