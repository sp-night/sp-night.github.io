---
/**
 * The mark: Pico do Jaraguá at dusk.
 *
 * The highest point in São Paulo, seen at nightfall — the summit silhouette
 * against the sodium horizon, the aviation beacon on top of the tower, and the
 * city's lights at the foot of the range.
 *
 * Drawn inline with --sp-* custom properties rather than loaded as a file, so
 * it retints the instant the flavour changes. The generated favicons in
 * public/ are the same drawing with the hexes baked in (scripts/gen-assets.mjs).
 */
interface Props {
  size?: number;
  /** Gradient ids must be unique per instance on a page. */
  id?: string;
  class?: string;
}
const { size = 26, id = 'mark', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="SP Night — the Pico do Jaraguá at dusk"
>
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--sp-vao)"></stop>
      <stop offset="0.26" style="stop-color: var(--sp-vao)"></stop>
      <stop offset="0.52" style="stop-color: var(--sp-temporal); stop-opacity: 0.44"></stop>
      <stop offset="0.78" style="stop-color: var(--sp-sodio); stop-opacity: 0.72"></stop>
      <stop offset="1" style="stop-color: var(--sp-taxi); stop-opacity: 0.9"></stop>
    </linearGradient>
    <radialGradient id={`${id}-beacon`}>
      <stop offset="0" style="stop-color: var(--sp-brasa); stop-opacity: 0.62"></stop>
      <stop offset="1" style="stop-color: var(--sp-brasa); stop-opacity: 0"></stop>
    </radialGradient>
  </defs>

  <rect width="64" height="64" rx="13" fill={`url(#${id}-sky)`}></rect>

  {/* the range behind, hazed by distance */}
  <path
    d="M-2 64 C4 59 9 53 15 49 C20 46 24 45 28 47 C32 49 35 53 39 53 C44 53 49 47 55 45 C59 43 63 47 66 51 L66 64 Z"
    fill="var(--sp-concreto)"
    opacity="0.6"></path>

  {/*
    The massif: a steep forested dome, and the neighbouring summit — Pico do
    Papagaio, 1,127 m to Jaraguá's 1,135 m — off to the right with a mast of
    its own. Rounded, because this is eroded Atlantic forest, not alpine rock.
  */}
  <path
    d="M-2 64 C7 60 13 55 19 50 C24 45 27 33 32 33 C37 33 41 43 46 47 C50 50 54 46 58 46 C61 46 64 50 66 53 L66 64 Z"
    fill="var(--sp-vao)"></path>

  {/* São Paulo, down at the foot of the range */}
  <g fill="var(--sp-sodio)" opacity="0.9">
    <rect x="5" y="60.4" width="1.4" height="1.4"></rect>
    <rect x="9.5" y="61.6" width="1.4" height="1.4"></rect>
    <rect x="14" y="60.6" width="1.4" height="1.4"></rect>
    <rect x="51" y="61" width="1.4" height="1.4"></rect>
    <rect x="55.5" y="61.8" width="1.4" height="1.4"></rect>
    <rect x="59.5" y="60.4" width="1.4" height="1.4"></rect>
  </g>

  {/* a mast on the neighbouring summit */}
  <line x1="58" y1="46" x2="58" y2="39" stroke="var(--sp-fg-muted)" stroke-width="0.8" opacity="0.8"></line>

  {/*
    The tower. This is the landmark — a very tall, slender lattice mast banded
    red and white, taller than the visible hill and visible from half the city.
    The mountain is the pedestal; the tower is what you recognise.
  */}
  <path d="M29.4 33 L31.32 6 L32.68 6 L34.6 33 Z" fill="var(--sp-fg)"></path>
  <path d="M31.32 6 L32.68 6 L32.95 9.86 L31.05 9.86 Z" fill="var(--sp-brasa)"></path>
  <path d="M30.77 13.71 L33.23 13.71 L33.5 17.57 L30.5 17.57 Z" fill="var(--sp-brasa)"></path>
  <path d="M30.22 21.43 L33.78 21.43 L34.05 25.29 L29.95 25.29 Z" fill="var(--sp-brasa)"></path>
  <path d="M29.67 29.14 L34.33 29.14 L34.6 33 L29.4 33 Z" fill="var(--sp-brasa)"></path>

  {/* the aviation beacon — the thing you actually see from the city at night */}
  <circle cx="32" cy="4.6" r="5.5" fill={`url(#${id}-beacon)`}></circle>
  <circle cx="32" cy="4.6" r="1.7" fill="var(--sp-brasa)" class="mark__beacon"></circle>
</svg>

<style>
  svg {
    display: block;
    flex: 0 0 auto;
  }

  /* Same slow pulse as the beacons in the skyline. */
  .mark__beacon {
    animation: mark-beacon 3.4s ease-in-out infinite;
  }

  @keyframes mark-beacon {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark__beacon {
      animation: none;
    }
  }
</style>
