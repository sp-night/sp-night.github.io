---
/**
 * Overhead wiring as a divider — `fiacao` is the palette's name for borders
 * because the wires cutting across São Paulo's sky are what divide it.
 *
 * Two or three cables hung between poles off either edge of the page, each
 * with its own sag, the lower one a little heavier. The SVG stretches to the
 * full width (preserveAspectRatio none), and non-scaling strokes keep the
 * cables one pixel wide however wide the screen is.
 *
 * `seed` varies the sag, so two wires on the same page are not identical.
 */
interface Props {
  seed?: number;
  /** Above the footer: takes its own room instead of straddling a boundary. */
  edge?: boolean;
  class?: string;
}
const { seed = 0, edge = false, class: className } = Astro.props;

const sag = [34, 40, 30, 44][seed % 4]!;
const drop = [5, 3, 7, 4][seed % 4]!;
const cables = [
  { y: 6, sag, w: 1.1, o: 0.95 },
  { y: 6 + drop, sag: sag + 6, w: 1.6, o: 0.8 },
  { y: 3, sag: sag - 9, w: 0.8, o: 0.55 },
];
// Asymmetric control points: the lowest point is off-centre, the way a real
// span sags when the poles are not the same height.
const path = (c: (typeof cables)[number]) =>
  `M-20 ${c.y} C ${300 + seed * 40} ${c.y + c.sag}, ${820 + seed * 30} ${c.y + c.sag}, 1220 ${c.y + 2}`;
---

<div class:list={['wire', edge && 'wire--edge', className]} aria-hidden="true">
  <svg viewBox="0 0 1200 64" preserveAspectRatio="none">
    {
      cables.map((c) => (
        <path
          d={path(c)}
          fill="none"
          stroke="var(--sp-fiacao)"
          stroke-width={c.w}
          stroke-opacity={c.o}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </svg>
</div>

<style>
  .wire {
    position: relative;
    z-index: 1;
    height: 4rem;
    /* Hung across the boundary between two sections, half on each. */
    margin-block: -2rem;
    pointer-events: none;
  }

  .wire--edge {
    margin-block: 1rem -2rem;
  }

  /* The cables start off either edge, so the svg clips them: left visible,
     the overflow widened the document and painted a strip past the page. */
  .wire svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* A wire in the wind: the sag breathes, very slowly. */
  .wire path {
    transform-origin: 50% 0;
    transform-box: view-box;
    animation: wire-sway 9s ease-in-out infinite alternate;
    transition: stroke var(--sp-retint) ease;
  }

  .wire path:nth-child(2) {
    animation-duration: 11s;
    animation-delay: -3s;
  }

  .wire path:nth-child(3) {
    animation-duration: 7.5s;
    animation-delay: -5s;
  }

  @keyframes wire-sway {
    from {
      transform: scaleY(0.94);
    }
    to {
      transform: scaleY(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire path {
      animation: none;
    }
  }
</style>
