---
/**
 * A synthetic terminal, drawn from a declarative preview and coloured entirely
 * through the role layer. It stands in for a screenshot: it cannot fall out of
 * sync with the palette, and it retints with the flavour switcher.
 *
 * The same shape the port catalogue declares, so this renders a port's preview
 * and the port repository's own SVG from one description. Where a preview
 * prints a hex as *text* — `{r:ui.bg}`, the mockup of a command that reports
 * the colour it is painting with — the value is resolved per flavour into
 * `data-f` spans. The colour of a span is always a custom property, never a
 * resolved hex: a hex in an attribute would freeze the mock to one flavour and
 * plant a literal where tests/no-raw-hex.test.ts would find it.
 */
import type { Preview } from '../data/ports';
import { isFlavored } from '../data/ports';
import { previewText, spanColor } from '../data/preview';
import { flavors, keyVar, roleVar } from '../data/palette';

interface Props {
  preview: Preview;
  compact?: boolean;
  /** Thumbnail mode: show only the first N lines, faded out at the bottom. */
  lines?: number;
  /** For a decorative thumbnail whose card already carries the name and blurb. */
  decorative?: boolean;
}

const { preview, compact = false, lines, decorative = false } = Astro.props;

const body = lines ? preview.body.slice(0, lines) : preview.body;

const swatchVars = (preview.swatches.roles ?? []).map((r) => {
  const [g, role] = r.split('.');
  return roleVar(g!, role!);
});
const swatches = swatchVars.length
  ? swatchVars
  : (preview.swatches.keys ?? []).map((k) => keyVar(k));

const classes = ['term', compact && 'term--compact', lines && 'term--thumb']
  .filter(Boolean)
  .join(' ');
---

<div
  class={classes}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : `A terminal window themed with SP Night, titled ${preview.title}`}
>
  <div class="term__bar">
    <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term__title mono">{
      isFlavored(preview.title)
        ? flavors.map((f) => <span data-f={f.id}>{previewText(preview.title, f)}</span>)
        : preview.title
    }</span>
  </div>

  <pre class="term__body mono">{body.map((line, i) => (<>{i > 0 && '\n'}{line.map((s) => (
    <span class={s.b ? 'b' : undefined} style={`color: ${spanColor(s)}`}>{
      isFlavored(s.t)
        ? flavors.map((f) => <span data-f={f.id}>{previewText(s.t, f)}</span>)
        : s.t
    }</span>
  ))}</>))}</pre>

  <div class="term__strip">
    <span class="term__strip-label mono">{preview.swatches.label}</span>
    <div class="term__swatches" aria-hidden="true">
      {swatches.map((v) => <span style={`background: ${v}`}></span>)}
    </div>
  </div>
</div>

<style>
  .term {
    background: var(--sp-vao);
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 22px 60px -28px color-mix(in oklab, var(--sp-vao) 90%, transparent);
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.8rem;
    background: var(--sp-concreto);
    border-bottom: var(--border);
  }

  .term__dots {
    display: inline-flex;
    gap: 5px;
  }

  .term__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sp-fiacao);
  }

  .term__dots i:first-child {
    background: var(--sp-brasa);
  }

  .term__dots i:nth-child(2) {
    background: var(--sp-taxi);
  }

  .term__dots i:last-child {
    background: var(--sp-ibira);
  }

  .term__title {
    font-size: var(--step--1);
    color: var(--sp-fg-muted);
  }

  .term__body {
    margin: 0;
    padding: 1rem 1.1rem 1.2rem;
    font-size: clamp(0.7rem, 0.62rem + 0.32vw, 0.85rem);
    line-height: 1.7;
    color: var(--sp-fg);
    overflow-x: auto;
    tab-size: 2;
  }

  .term__body .b {
    font-weight: 700;
  }

  .term--compact .term__body {
    font-size: 0.72rem;
    line-height: 1.6;
  }

  /* ------------------------------------------------------------ swatches */

  .term__strip {
    padding: 0 1.1rem 1rem;
  }

  .term__strip-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--sp-fg-muted);
    margin-bottom: 0.4rem;
  }

  .term__swatches {
    display: flex;
    gap: 4px;
  }

  .term__swatches span {
    flex: 1;
    height: 12px;
    border-radius: 3px;
  }

  /* --------------------------------------------------------- thumbnail */

  /* The strip is the most recognisable part of the mock, so it survives the
     crop: only the session fades. */
  .term--thumb .term__body {
    overflow: hidden;
    padding-bottom: 0.4rem;
    -webkit-mask-image: linear-gradient(to bottom, black 68%, transparent);
    mask-image: linear-gradient(to bottom, black 68%, transparent);
  }
</style>
