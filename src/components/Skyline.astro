<style is:global>
  .skyline-wrap {
    position: relative;
    line-height: 0;
    --sp-haze: 0.18;
  }

  svg#skyline {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The viewBox is 1200x250, so on a phone the skyline collapses to ~80px and
     loses all its shape. It stretches instead — a taller city, not a thinner one. */
  @media (max-width: 40rem) {
    svg#skyline {
      min-height: 160px;
    }
  }

  /* Retint smoothly on flavour change — but not the hundreds of tiny windows,
     which would turn one attribute change into a very expensive frame. */
  #skyline path,
  #skyline ellipse,
  #skyline circle,
  #skyline > rect {
    transition: fill 0.45s ease;
  }

  /* Garoa is flat grey by definition — the sodium wash is pulled right back so
     the drizzle reads as haze rather than as a warm glow. */
  html[data-flavor='garoa'] .skyline-wrap {
    --sp-haze: 0.06;
  }

  .haze-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, var(--sp-sodio), transparent 55%);
    opacity: var(--sp-haze);
    mix-blend-mode: soft-light;
    animation: haze-breathe 14s ease-in-out infinite;
  }

  @keyframes haze-breathe {
    0%,
    100% {
      opacity: var(--sp-haze);
    }
    50% {
      opacity: calc(var(--sp-haze) * 1.45);
    }
  }

  /* the sodium wash over the rooftops, pulsing very slowly */
  .glow {
    animation: glow-pulse 11s ease-in-out infinite;
    transform-origin: bottom;
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 1;
    }
  }

  .beacon {
    animation: beacon 2.2s ease-in-out infinite;
  }

  @keyframes beacon {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }

  /* someone is still up, and moves across the room */
  .win--flicker {
    animation-name: win-flicker;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }

  /* fill-opacity multiplies the element's own opacity, so each window keeps the
     brightness it was generated with and only dips relative to it. */
  @keyframes win-flicker {
    0%,
    46% {
      fill-opacity: 1;
    }
    47%,
    53% {
      fill-opacity: 0.08;
    }
    54%,
    88% {
      fill-opacity: 1;
    }
    89%,
    94% {
      fill-opacity: 0.08;
    }
    95%,
    100% {
      fill-opacity: 1;
    }
  }

  .star {
    animation-name: twinkle;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      fill-opacity: 0.45;
    }
    50% {
      fill-opacity: 1;
    }
  }

  .rainfall {
    animation: rainfall 2.1s linear infinite;
  }

  @keyframes rainfall {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(250px);
    }
  }

  .clouds {
    animation: drift 44s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translateX(-18px);
    }
    to {
      transform: translateX(22px);
    }
  }

  .birds {
    animation: birds 26s linear infinite;
  }

  @keyframes birds {
    from {
      transform: translate(-60px, 6px);
      opacity: 0;
    }
    12% {
      opacity: 0.5;
    }
    88% {
      opacity: 0.5;
    }
    to {
      transform: translate(340px, -22px);
      opacity: 0;
    }
  }

  /* The peak is always on the city's horizon (#pico-distante). In the jaragua
     flavour the camera climbs the range: the peak becomes the foreground and
     the city becomes the lights far below. The weather is flavour-bound too —
     stars on the clear night, drizzle in the garoa. */
  #pico-jaragua,
  #parque-villalobos,
  #garoa-chuva,
  #estrelas {
    display: none;
  }

  html[data-flavor='noite'] #estrelas {
    display: block;
  }

  /* Garoa moves west to Parque Villa-Lobos: the Roda Rico turning in the
     drizzle, with the Marginal Pinheiros running past its feet. */
  html[data-flavor='garoa'] #garoa-chuva,
  html[data-flavor='garoa'] #parque-villalobos {
    display: block;
  }

  html[data-flavor='garoa'] #cena-cidade {
    display: none;
  }

  html[data-flavor='jaragua'] #pico-jaragua {
    display: block;
  }

  html[data-flavor='jaragua'] #cena-cidade,
  html[data-flavor='jaragua'] .marginal {
    display: none;
  }

  /*
    The wheel turns continuously — it never stops boarding. The real thing
    takes about 25 minutes for a full revolution; 100s here is the same idea
    at a speed you can perceive without it becoming a distraction.
  */
  .roda-gira {
    transform-box: view-box;
    transform-origin: 800px 98px;
    animation: roda 100s linear infinite;
  }

  @keyframes roda {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* A slow chase runs the spokes, the way the real light show breathes. */
  .raio {
    animation: raio 9s ease-in-out infinite;
  }

  @keyframes raio {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 0.3;
    }
  }

  .roda-halo {
    animation: roda-halo 9s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: 800px 98px;
  }

  @keyframes roda-halo {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.72;
    }
  }

  /* Each cabin hangs level, so it counter-turns at exactly the wheel's rate. */
  .cabine {
    transform-box: fill-box;
    transform-origin: center;
    animation: cabine 100s linear infinite;
  }

  @keyframes cabine {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  .marginal {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    height: 14px;
    overflow: hidden;
    pointer-events: none;
  }

  .lane {
    position: relative;
    height: 4px;
    margin-bottom: 3px;
  }

  .trail {
    position: absolute;
    top: 0;
    height: 3px;
    width: 64px;
    border-radius: 2px;
    filter: blur(1.5px);
    opacity: 0.75;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .trail--short {
    width: 34px;
    opacity: 0.5;
  }

  .lane-red .trail {
    background: linear-gradient(to right, transparent, var(--sp-brasa));
    animation-name: driveL;
  }

  .lane-white .trail {
    background: linear-gradient(to left, transparent, var(--sp-sodio));
    animation-name: driveR;
  }

  @keyframes driveL {
    from {
      left: 100%;
    }
    to {
      left: -70px;
    }
  }

  @keyframes driveR {
    from {
      left: -70px;
    }
    to {
      left: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beacon,
    .win--flicker,
    .star,
    .rainfall,
    .clouds,
    .birds,
    .glow,
    .haze-overlay,
    .roda-gira,
    .cabine,
    .raio,
    .roda-halo {
      animation: none;
    }
    .beacon {
      opacity: 0.7;
    }
    .trail {
      animation: none !important;
      opacity: 0.3;
    }
  }
</style>
