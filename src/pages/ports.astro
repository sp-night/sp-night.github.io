---
import Base from '../layouts/Base.astro';
import { ports, portsByGroup } from '../data/ports';

const names = ports.map((p) => p.name).join(' and ');
const description = `SP Night for ${names} — every port a repository of its own, installable today.`;
---

<Base title="Ports" description={description}>
  <p class="eyebrow">ports</p>
  <h1>{ports.length === 1 ? 'One port' : `${ports.length} ports`}, one palette</h1>
  <p class="lede">
    Everything on this page exists. Each port is a repository of its own, holding finished theme
    files you can install right now — no build step, no tooling, nothing to compile. When another
    app is themed, it appears here the same way.
  </p>

  {
    portsByGroup.map(({ label, items }) => (
      <section class="group">
        <h2 class="group__label mono">
          {label}
          <span class="group__count">{items.length}</span>
        </h2>
        <ul role="list" class="ports">
          {items.map((p, i) => (
            <li class:list={['port', 'reveal', { 'port--live': p.repo }]} style={`--d: ${i * 60}ms`}>
              <div class="port__head">
                <a class="port__name" href={p.homepage}>{p.name}</a>
                <a class="port__status port__status--live" href={p.repo}>
                  <span class="port__lamp" aria-hidden="true" /> repo ↗
                </a>
              </div>
              <p class="port__blurb">{p.blurb}</p>
              <dl class="port__meta mono">
                <div>
                  <dt>file</dt>
                  <dd>{p.install}</dd>
                </div>
                {p.activate && (
                  <div>
                    <dt>use</dt>
                    <dd>{p.activate}</dd>
                  </div>
                )}
              </dl>
              {p.note && <p class="port__note">{p.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="cta">
    <h2>Theming another app</h2>
    <p>
      The colour decisions are already made and written down: the palette is public data and the
      spec says which role each thing gets. Building a port means mapping your app's config keys
      onto those roles — the hard part is already done.
    </p>
    <a class="btn" href="/contribute">How to build a port</a>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------------ groups */

  .group {
    margin-block: 3rem;
  }

  .group__label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sp-fg-muted);
    border-bottom: var(--border);
    padding-bottom: 0.55rem;
  }

  .group__count {
    color: var(--sp-sodio);
    font-weight: 400;
  }

  /* ------------------------------------------------------------------- cards */

  .ports {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .port {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.05rem 1.15rem;
    background: var(--sp-laje);
    border: var(--border);
    border-radius: var(--radius);
    transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s ease, background-color 0.45s ease;
  }

  .port:hover {
    border-color: color-mix(in oklab, var(--sp-sodio) 45%, var(--sp-fiacao));
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px color-mix(in oklab, var(--sp-sodio) 55%, transparent);
  }

  /* the shipped port carries the lamp: warm border even at rest */
  .port--live {
    border-color: color-mix(in oklab, var(--sp-sodio) 40%, var(--sp-fiacao));
    background: linear-gradient(
        160deg,
        color-mix(in oklab, var(--sp-sodio) 6%, transparent),
        transparent 45%
      ),
      var(--sp-laje);
  }

  .port__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .port__name {
    font-weight: 620;
    font-size: var(--step-0);
    color: var(--sp-fg);
    text-decoration: none;
  }

  .port__name:hover {
    color: var(--sp-marginal-vivo);
  }

  .port__status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--sp-fg-muted);
    background: var(--sp-concreto);
    border: var(--border);
    border-radius: 999px;
    padding: 0.14rem 0.6rem;
    white-space: nowrap;
  }

  .port__status--live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sp-sodio);
    border-color: color-mix(in oklab, var(--sp-sodio) 45%, var(--sp-fiacao));
    text-decoration: none;
  }

  .port__status--live:hover {
    color: var(--sp-taxi);
    border-color: var(--sp-sodio);
  }

  .port__lamp {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 7px currentColor;
  }

  .port__blurb {
    margin: 0;
    font-size: var(--step--1);
    color: var(--sp-fg-dim);
  }

  /* the caveat that only some ports carry — quieter than the blurb */
  .port__note {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--sp-fg-muted);
    border-left: 2px solid color-mix(in oklab, var(--sp-sodio) 40%, transparent);
    padding-left: 0.6rem;
  }

  /* -------------------------------------------------------------- card meta */

  .port__meta {
    margin: auto 0 0;
    padding-top: 0.65rem;
    border-top: 1px solid color-mix(in oklab, var(--sp-fiacao) 60%, transparent);
    display: grid;
    gap: 0.3rem;
    font-size: 0.72rem;
  }

  .port__meta div {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .port__meta dt {
    flex: 0 0 2.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sp-fg-muted);
  }

  .port__meta dd {
    margin: 0;
    color: var(--sp-fg-dim);
    overflow-wrap: anywhere;
  }

  /* --------------------------------------------------------------------- cta */

  .cta {
    margin-block: 3.5rem;
    max-width: var(--measure);
  }

  .cta h2 {
    font-size: var(--step-1);
  }
</style>
