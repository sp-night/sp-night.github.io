---
import Base from '../layouts/Base.astro';
import { ports, portsByGroup } from '../data/ports';
import { inlineMd } from '../data/guide';

const names = ports.map((p) => p.name).join(' and ');
const description = `SP Night for ${names} — every port a repository of its own, installable today.`;

// Blurbs are markdown fragments in the catalogue; the card used to print the
// backticks. The install path and the caveat moved to the port's own page.
const blurbs = Object.fromEntries(
  await Promise.all(ports.map(async (p) => [p.slug, await inlineMd(p.blurb)] as const)),
);

// The filter is one generated rule per group, which is what keeps it free of
// JavaScript: CSS cannot compare a checked radio's value against a section's
// group, but it can be told about each group by name. The list comes from the
// catalogue, so a new group filters itself.
//
// With "All" checked no rule matches and everything shows — which is also what
// happens if `:has()` is unavailable. The page degrades to the way it was.
const filterCss = portsByGroup
  .map(
    ({ group }) =>
      `.ports-page:has(#f-${group}:checked) .group:not([data-group="${group}"]){display:none}`,
  )
  .join('');
---

<Base title="Ports" description={description}>
  <p class="eyebrow">ports</p>
  <h1>{ports.length === 1 ? 'One port' : `${ports.length} ports`}, one palette</h1>
  <p class="lede">
    Everything on this page exists. Each port is a repository of its own, holding finished theme
    files you can install right now — no build step, no tooling, nothing to compile. When another
    app is themed, it appears here the same way.
  </p>

  <div class="ports-page">
    <style is:inline set:html={filterCss} />

    {
      portsByGroup.length > 1 && (
        <fieldset class="filter">
          <legend class="visually-hidden">Filter by group</legend>
          <input type="radio" name="group" id="f-all" checked />
          <label class="mono" for="f-all">
            All <span class="filter__n">{ports.length}</span>
          </label>
          {portsByGroup.map(({ group, label, items }) => (
            <>
              <input type="radio" name="group" id={`f-${group}`} />
              <label class="mono" for={`f-${group}`}>
                {label} <span class="filter__n">{items.length}</span>
              </label>
            </>
          ))}
        </fieldset>
      )
    }

    {
      portsByGroup.map(({ group, label, items }) => (
        <section class="group" data-group={group}>
          <h2 class="group__label mono">
            {label}
            <span class="group__count">{items.length}</span>
          </h2>
          <ul role="list" class="ports">
            {items.map((p, i) => (
              <li class="port reveal" style={`--d: ${i * 40}ms`}>
                <div class="port__head">
                  {/* Stretched: the whole card is the hit target, without nesting
                      anchors or reaching for JavaScript. */}
                  <a class="port__name" href={`/ports/${p.slug}`}>{p.name}</a>
                  <a class="port__status port__status--live" href={p.repo}>
                    <span class="port__lamp" aria-hidden="true" /> repo ↗
                  </a>
                </div>
                <p class="port__blurb" set:html={blurbs[p.slug]} />
                <dl class="port__meta mono">
                  <div>
                    <dt>file</dt>
                    <dd>{p.install}</dd>
                  </div>
                </dl>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="cta">
    <h2>Theming another app</h2>
    <p>
      The colour decisions are already made and written down: the palette is public data and the
      spec says which role each thing gets. Building a port means mapping your app's config keys
      onto those roles — the hard part is already done.
    </p>
    <a class="btn" href="/contribute">How to build a port</a>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------------ filter */

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 2rem 0 0;
  }

  /* Off-screen rather than display:none — a hidden input is not focusable, and
     the label is the only way to reach these by keyboard. */
  .filter input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .filter label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--sp-fg-dim);
    background: var(--sp-concreto);
    border: var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .filter label:hover {
    color: var(--sp-fg);
    border-color: color-mix(in oklab, var(--sp-sodio) 40%, var(--sp-fiacao));
  }

  .filter input:checked + label {
    color: var(--sp-sodio);
    border-color: color-mix(in oklab, var(--sp-sodio) 55%, var(--sp-fiacao));
    background: color-mix(in oklab, var(--sp-sodio) 10%, var(--sp-concreto));
  }

  .filter input:focus-visible + label {
    outline: 2px solid var(--sp-sodio);
    outline-offset: 2px;
  }

  .filter__n {
    color: var(--sp-fg-muted);
  }

  .filter input:checked + label .filter__n {
    color: inherit;
  }

  /* ------------------------------------------------------------------ groups */

  .group {
    margin-block: 2.25rem;
  }

  .group__label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sp-fg-muted);
    border-bottom: var(--border);
    padding-bottom: 0.55rem;
  }

  .group__count {
    color: var(--sp-sodio);
    font-weight: 400;
  }

  /* ------------------------------------------------------------------- cards */

  /* Narrower tracks than the cards used to need: with the preview gone the card
     is four short lines, so more of them fit a row and a long list stops being a
     scroll. The preview lives on the port's own page, one click away, at the
     size it was drawn for. */
  .ports {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  /* Every port carries the lamp: `repo` is required, so there is no unshipped
     card to distinguish it from. */
  .port {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border: var(--border);
    border-color: color-mix(in oklab, var(--sp-sodio) 40%, var(--sp-fiacao));
    border-radius: var(--radius);
    background: linear-gradient(
        160deg,
        color-mix(in oklab, var(--sp-sodio) 6%, transparent),
        transparent 45%
      ),
      var(--sp-laje);
    transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s ease, background-color 0.45s ease;
  }

  .port:hover {
    border-color: color-mix(in oklab, var(--sp-sodio) 45%, var(--sp-fiacao));
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px color-mix(in oklab, var(--sp-sodio) 55%, transparent);
  }

  .port:focus-within {
    border-color: var(--sp-sodio);
  }

  .port__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .port__name {
    font-weight: 620;
    font-size: var(--step-0);
    color: var(--sp-fg);
    text-decoration: none;
  }

  .port__name:hover {
    color: var(--sp-marginal-vivo);
  }

  /* The stretched hit target. The repo pill lifts above it so it stays
     independently clickable. */
  .port__name::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .port__status--live {
    position: relative;
    z-index: 1;
  }

  .port__status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--sp-fg-muted);
    background: var(--sp-concreto);
    border: var(--border);
    border-radius: 999px;
    padding: 0.14rem 0.6rem;
    white-space: nowrap;
  }

  .port__status--live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sp-sodio);
    border-color: color-mix(in oklab, var(--sp-sodio) 45%, var(--sp-fiacao));
    text-decoration: none;
  }

  .port__status--live:hover {
    color: var(--sp-taxi);
    border-color: var(--sp-sodio);
  }

  .port__lamp {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 7px currentColor;
  }

  .port__blurb {
    margin: 0;
    font-size: var(--step--1);
    color: var(--sp-fg-dim);
  }

  /* the caveat that only some ports carry — quieter than the blurb */
  .port__note {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--sp-fg-muted);
    border-left: 2px solid color-mix(in oklab, var(--sp-sodio) 40%, transparent);
    padding-left: 0.6rem;
  }

  /* -------------------------------------------------------------- card meta */

  .port__meta {
    margin: auto 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in oklab, var(--sp-fiacao) 60%, transparent);
    display: grid;
    gap: 0.3rem;
    font-size: 0.72rem;
  }

  .port__meta div {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .port__meta dt {
    flex: 0 0 2.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sp-fg-muted);
  }

  .port__meta dd {
    margin: 0;
    color: var(--sp-fg-dim);
    overflow-wrap: anywhere;
  }

  /* --------------------------------------------------------------------- cta */

  .cta {
    margin-block: 3.5rem;
    max-width: var(--measure);
  }

  .cta h2 {
    font-size: var(--step-1);
  }
</style>
