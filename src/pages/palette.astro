---
import Base from '../layouts/Base.astro';
import ColorCard from '../components/ColorCard.astro';
import { GROUPS, flavors, type ColorGroup } from '../data/palette';

const groupOrder: ColorGroup[] = ['surfaces', 'text', 'accents', 'vivo'];
---

<Base
  title="Palette"
  description="Twenty-two colours across three dark flavours, each named after something in São Paulo — surfaces, text, accents and the terminal bright pairs."
>
  <p class="eyebrow">palette</p>
  <h1>Twenty-two colours, three ways to look at the same city</h1>
  <p class="lede">
    Every flavour is dark by decision, not by omission. They differ in hue and chroma, never in
    brightness — switch between them with the control in the header and the whole site follows.
    Click any colour to copy the hex for the flavour you are looking at.
  </p>

  <section class="flavor-notes" aria-label="Flavours">
    {
      flavors.map((f) => (
        <article class="card flavor-note">
          <header>
            <span class="flavor-note__dots" aria-hidden="true">
              {['vao', 'concreto', 'sodio', 'marginal', 'ibira'].map((k) => (
                <span style={`background: ${f.colors[k]?.hex}`} />
              ))}
            </span>
            <h2>{f.label}</h2>
            <code class="mono muted">{f.id}</code>
          </header>
          <p>{f.description}</p>
        </article>
      ))
    }
  </section>

  {
    groupOrder.map((g) => (
      <section class="group" aria-labelledby={`group-${g}`}>
        <div class="group__head">
          <h2 id={`group-${g}`}>{GROUPS[g].label}</h2>
          <p class="muted">{GROUPS[g].blurb}</p>
        </div>
        <div class="group__grid">
          {GROUPS[g].keys.map((key) => (
            <ColorCard colorKey={key} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="group" aria-labelledby="ansi">
    <div class="group__head">
      <h2 id="ansi">Terminal mapping</h2>
      <p class="muted">
        The sixteen ANSI slots, resolved through the semantic role layer. Note that
        <code>sodio</code> and <code>estaiada</code> deliberately have no ANSI slot — they are
        identity colours, not terminal colours.
      </p>
    </div>
    <div class="ansi-grid">
      {
        Object.keys(flavors[0]!.roles.ansi!).map((role) => (
          <div class="ansi">
            <span class="ansi__chip" style={`background: var(--sp-${flavors[0]!.roles.ansi![role]!.key.replace(/_/g, '-')})`} aria-hidden="true" />
            <span class="mono ansi__role">{role}</span>
            <span class="mono muted ansi__key">{flavors[0]!.roles.ansi![role]!.key}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .flavor-notes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin-block: 2.5rem 3.5rem;
  }

  .flavor-note header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .flavor-note h2 {
    font-size: var(--step-1);
    margin: 0;
  }

  .flavor-note p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--sp-fg-dim);
  }

  .flavor-note__dots {
    display: inline-flex;
    gap: 3px;
    width: 100%;
  }

  .flavor-note__dots span {
    width: 1.4rem;
    height: 0.4rem;
    border-radius: 2px;
  }

  .group {
    margin-block: 3rem;
  }

  .group__head {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
  }

  .group__head h2 {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .group__head p {
    margin: 0;
    font-size: var(--step--1);
  }

  .group__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .ansi-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }

  .ansi {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2rem 0.55rem;
    padding: 0.45rem 0.7rem;
    background: var(--sp-laje);
    border: var(--border);
    border-radius: 8px;
    font-size: var(--step--1);
  }

  .ansi__chip {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
    flex: 0 0 auto;
  }

  .ansi__role {
    min-width: 0;
  }

  /* Long keys like temporal_vivo used to run past the card edge. */
  .ansi__key {
    margin-left: auto;
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
</style>
