---
import Base from '../layouts/Base.astro';
import ColorCard from '../components/ColorCard.astro';
import { COLOUR_COUNT, GROUPS, GROUP_IDS, flavors } from '../data/palette';

const groupOrder = GROUP_IDS;

/* One rule per flavour, generated from the list so a new flavour needs no
   edit here: which ink each swatch's name uses, and which hex is lit. */
const flavorCss = flavors
  .map(
    (f) =>
      `:root[data-flavor="${f.id}"] .color{--on:var(--on-${f.id})}` +
      `:root[data-flavor="${f.id}"] .color__hex[data-hex="${f.id}"]{color:var(--sp-fg)}`,
  )
  .join('');

/* The surfaces are planes stacked on each other, so they are shown the way
   they are used: one continuous slab, darkest recess to the wiring. */
const slab = GROUPS.surfaces?.keys ?? [];
---

<Base
  title="Palette"
  description={`${COLOUR_COUNT} colours across three dark flavours, each named after something in São Paulo — surfaces, text, accents and the terminal bright pairs.`}
>
  <style is:inline set:html={flavorCss} />
  <p class="eyebrow">palette</p>
  <h1>{COLOUR_COUNT} colours, three ways to look at the same city</h1>
  <p class="lede">
    Every flavour is dark by decision, not by omission. They differ in hue and chroma, never in
    brightness — switch between them with the control in the header and the whole site follows.
    Click any colour to copy the hex for the flavour you are looking at.
  </p>

  <section class="flavor-notes" aria-label="Flavours">
    {
      flavors.map((f) => (
        <article class="card flavor-note" data-flavor-item={f.id}>
          <header>
            <span class="flavor-note__dots" aria-hidden="true">
              {['vao', 'concreto', 'sodio', 'marginal', 'ibira'].map((k) => (
                <span style={`background: ${f.colors[k]?.hex}`} />
              ))}
            </span>
            <h2>{f.label}</h2>
            <code class="mono muted">{f.id}</code>
          </header>
          <p>{f.description}</p>
        </article>
      ))
    }
  </section>

  {
    groupOrder.map((g, gi) => (
      <section class="group" aria-labelledby={`group-${g}`}>
        <div class="group__head">
          <h2 id={`group-${g}`}>{GROUPS[g]!.label}</h2>
          <p class="muted">{GROUPS[g]!.blurb}</p>
        </div>
        {g === 'surfaces' && (
          <div class="slab" aria-hidden="true">
            {slab.map((k, i) => (
              <span class="slab__plane retint-wave" style={`--i: ${i}; background: var(--sp-${k.replace(/_/g, '-')})`}>
                <span class="mono">{k}</span>
              </span>
            ))}
          </div>
        )}
        <div class="group__grid">
          {GROUPS[g]!.keys.map((key, ki) => (
            <ColorCard
              colorKey={key}
              index={groupOrder.slice(0, gi).reduce((n, id) => n + GROUPS[id]!.keys.length, 0) + ki}
            />
          ))}
        </div>
      </section>
    ))
  }

  <section class="group" aria-labelledby="ansi">
    <div class="group__head">
      <h2 id="ansi">Terminal mapping</h2>
      <p class="muted">
        The sixteen ANSI slots, resolved through the semantic role layer. Note that
        <code>sodio</code> and <code>estaiada</code> deliberately have no ANSI slot — they are
        identity colours, not terminal colours.
      </p>
    </div>
    <div class="ansi-grid">
      {
        Object.keys(flavors[0]!.roles.ansi!).map((role) => (
          <div class="ansi">
            <span class="ansi__chip retint-wave" style={`--i: ${Object.keys(flavors[0]!.roles.ansi!).indexOf(role)}; background: var(--sp-${flavors[0]!.roles.ansi![role]!.key.replace(/_/g, '-')})`} aria-hidden="true" />
            <span class="mono ansi__role">{role}</span>
            <span class="mono muted ansi__key">{flavors[0]!.roles.ansi![role]!.key}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .flavor-notes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin-block: 2.5rem 3.5rem;
  }

  .flavor-note header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .flavor-note h2 {
    font-size: var(--step-1);
    margin: 0;
  }

  /* The note for the flavour on screen is lit; the other two wait their turn. */
  .flavor-note {
    opacity: 0.72;
  }

  .flavor-note:hover {
    opacity: 1;
  }

  :global(html[data-flavor='noite']) .flavor-note[data-flavor-item='noite'],
  :global(html[data-flavor='garoa']) .flavor-note[data-flavor-item='garoa'],
  :global(html[data-flavor='jaragua']) .flavor-note[data-flavor-item='jaragua'] {
    opacity: 1;
    border-color: color-mix(in oklab, var(--sp-sodio) 55%, var(--sp-fiacao));
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--sp-sodio) 25%, transparent),
      0 18px 40px -26px var(--sp-sodio);
    transform: translateY(-3px);
  }

  .flavor-note p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--sp-fg-dim);
  }

  .flavor-note__dots {
    display: inline-flex;
    gap: 3px;
    width: 100%;
  }

  .flavor-note__dots span {
    width: 1.4rem;
    height: 0.4rem;
    border-radius: 2px;
    transition: transform 0.35s var(--sp-ease);
  }

  .flavor-note:hover .flavor-note__dots span {
    transform: scaleX(1.25);
  }

  .group {
    margin-block: 3rem;
  }

  .group__head {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
  }

  .group__head h2 {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .group__head p {
    margin: 0;
    font-size: var(--step--1);
  }

  .group__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    align-items: start;
  }

  /* ---------------------------------------------------------------- slab */

  .slab {
    display: flex;
    height: 6.5rem;
    margin-bottom: 0.9rem;
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .slab__plane {
    flex: 1;
    display: flex;
    align-items: flex-end;
    padding: 0.6rem 0.75rem;
    transition: flex-grow 0.4s var(--sp-ease), background-color var(--sp-retint) ease
        calc(var(--i, 0) * 20ms);
  }

  .slab__plane:hover {
    flex-grow: 1.6;
  }

  .slab__plane span {
    font-size: 0.72rem;
    color: var(--sp-fg-dim);
  }

  @media (max-width: 34rem) {
    .slab {
      flex-direction: column;
      height: auto;
    }

    .slab__plane {
      min-height: 2.6rem;
    }
  }

  .ansi-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }

  .ansi {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2rem 0.55rem;
    padding: 0.45rem 0.7rem;
    background: var(--sp-laje);
    border: var(--border);
    border-radius: 8px;
    font-size: var(--step--1);
    transition: background-color var(--sp-retint) ease, border-color var(--sp-retint) ease,
      transform 0.25s var(--sp-ease);
  }

  .ansi:hover {
    border-color: var(--sp-fg-muted);
    transform: translateY(-1px);
  }

  .ansi__chip {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
    flex: 0 0 auto;
  }

  .ansi__role {
    min-width: 0;
  }

  /* Long keys like temporal_vivo used to run past the card edge. */
  .ansi__key {
    margin-left: auto;
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
</style>
