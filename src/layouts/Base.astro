---
import '../styles/global.css';
import FlavorSwitcher from '../components/FlavorSwitcher.astro';
import Logo from '../components/Logo.astro';
import { flavorStylesheet, defaultFlavor, theme, flavor, org } from '../data/palette';

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed pages (the home hero) opt out of the default container. */
  bare?: boolean;
  /** Pages that must not be indexed (the 404). */
  noindex?: boolean;
}

const {
  title,
  description = theme.description,
  bare = false,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${theme.label}` : `${theme.label} — a São Paulo dark theme`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/palette', label: 'palette' },
  { href: '/spec', label: 'spec' },
  { href: '/ports', label: 'ports' },
  { href: '/contribute', label: 'contribute' },
];
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
const seed = flavor(defaultFlavor);

// Social cards need an absolute URL; `site` is set in astro.config.mjs, with a
// dev-origin fallback for local servers where it may be absent.
const origin = Astro.site ?? 'http://localhost:4321';
const ogImage = new URL(`/og-${defaultFlavor}.png`, origin).href;
const ogImageAlt = `${theme.label} — the São Paulo skyline at night under the sodium lamp, with the eight accent colours as swatches`;

// Canonical carries the trailing slash, matching the URLs the sitemap emits.
const canonical = new URL(path === '/' ? '/' : `${path}/`, origin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      name: theme.label,
      url: `${origin}`,
      description: theme.description,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${origin}#theme`,
      name: theme.label,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      url: `${origin}`,
      description: theme.description,
      license: 'https://opensource.org/license/MIT',
      author: { '@id': `${origin}#org` },
      sameAs: [org.url, org.engine, org.site],
    },
    {
      '@type': 'Organization',
      '@id': `${origin}#org`,
      name: theme.label,
      url: `${origin}`,
      logo: new URL(`/logo-${defaultFlavor}.svg`, origin).href,
      sameAs: [org.url],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-flavor={defaultFlavor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={seed.colors.vao?.hex} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={theme.label} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Swapped client-side so the tab icon matches the flavour on screen. */}
    <link id="favicon" rel="icon" href={`/favicon-${defaultFlavor}.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style set:html={`  ${flavorStylesheet()}`}></style>

    {/* Set the stored flavour before first paint, so there is no flash. */}
    <script is:inline data-default={defaultFlavor}>
      (function () {
        var el = document.currentScript;
        var fallback = (el && el.dataset.default) || 'noite';
        var stored = null;
        try {
          stored = localStorage.getItem('sp-night-flavor');
        } catch (e) {}
        var flavor = q0() || stored || fallback;
        function q0() {
          return new URLSearchParams(location.search).get('flavor');
        }
        document.documentElement.dataset.flavor = flavor;
        var icon = document.getElementById('favicon');
        if (icon) icon.href = '/favicon-' + flavor + '.svg';
      })();
    </script>
  </head>

  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <Logo size={26} id="brand" />
          {theme.label}
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((i) => <a href={i.href} aria-current={current(i.href)}>{i.label}</a>)}
        </nav>
        <FlavorSwitcher />
      </div>
    </header>

    <main id="main">
      {bare ? <slot /> : <div class="wrap section"><slot /></div>}
    </main>

    <p id="copy-status" class="visually-hidden" role="status" aria-live="polite"></p>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>
          {theme.label} — a dark theme with São Paulo as its reference. Built by the{' '}
          <a href="/contribute#contributors">people who contribute to it</a>.
        </span>
        <span class="mono">
          <a href={theme.repoUrl}>github.com/sp-night</a> · MIT
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/copy';
      import '../scripts/motion';
    </script>
  </body>
</html>
